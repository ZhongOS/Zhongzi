# 构建linux_runtime的工具链和基础库
NULL@linux_runtime
make_directory@linux_runtime:core|%target=?x86_64;%OVERLAY=linux_runtime
NULL@cross-toolchains
@cross-toolchains:pre-tools|%target=?x86_64
NULL@linux_runtime
@linux_runtime:core|%target=?x86_64;%OVERLAY=linux_runtime
NULL@cross-toolchains
linux-gcc-libc@cross-toolchains|%target=?x86_64;%OVERLAY=linux_runtime
@cross-toolchains|%target=?x86_64;%OVERLAY=linux_runtime
NULL@cross-toolchains

# 构建linux_runtime的基础运行环境
NULL@linux_runtime
@linux_runtime|%target=?x86_64;%OVERLAY=x86_64_runtime
NULL@linux_runtime

