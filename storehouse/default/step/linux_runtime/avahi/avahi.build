<<<TAR_UNCOMPRESS>>>
        <<<PATCH>>>
        for config_i in $(find -name "config.sub")
        do
                cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
        done
        autoreconf -ifv

	sed -i '426a if (events & AVAHI_WATCH_HUP) { \
client_free(c); \
return; \
}' avahi-daemon/simple-protocol.c

        mkdir cross-build
        pushd cross-build
                ../configure ${COMMON_CONFIG} --enable-introspection=no  --disable-static --disable-libevent \
                --disable-mono --disable-monodoc --disable-python --disable-qt3 --disable-qt4 --disable-qt5 \
                --enable-core-docs --with-distro=none \
		--enable-compat-libdns_sd \
		--with-systemdsystemunitdir=/usr/lib/systemd/system \
                --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' \
		check_gnu_Makefile
                <<<MAKE>>> 
                make DESTDIR=${LINUX_SYSROOT_DIR} install
	popd
	ln -sf avahi-compat-libdns_sd.pc ${LINUX_SYSROOT_DIR}/usr/lib${LIB_SUFF}/pkgconfig/libdns_sd.pc
	ln -sf avahi-compat-libdns_sd/dns_sd.h ${LINUX_SYSROOT_DIR}/usr/include/

        rm -f ${LINUX_SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
<<<CLEAR_DIR>>>

