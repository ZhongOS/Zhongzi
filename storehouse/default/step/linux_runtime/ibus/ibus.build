<<<TAR_UNCOMPRESS>>>
    <<<PATCH>>>
    autoreconf -ifv
    for config_i in $(find -name "config.sub")
    do
            cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
    done

   sed -i "s@\$(builddir)/gen-internal-compose-table@qemu-${QEMU_NAME} \$(builddir)/gen-internal-compose-table@g" src/Makefile.in
   sed -i "s@\$(builddir)/unicode-parser@qemu-${QEMU_NAME} \$(builddir)/unicode-parser@g" src/Makefile.in
   sed -i "s@\$(builddir)/emoji-parser@qemu-${QEMU_NAME} \$(builddir)/emoji-parser@g" src/Makefile.in
#    sed -i "s@\$PKG_CONFIG_SYSROOT_DIR@@g" configure

    export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types"
    mkdir cross-build
    pushd cross-build
        ../configure ${COMMON_CONFIG} \
                     --disable-emoji-dict --disable-unicode-dict --enable-introspection=no --disable-python2 --disable-ui
	check_gnu_Makefile
	<<<MAKE>>> CC_FOR_BUILD=${LINUX_HOST}-gcc GLIB_COMPILE_RESOURCES=${CROSS_TOOLS_PREFIX}/bin/${LINUX_HOST}-glib-compile-resources
        make DESTDIR=${LINUX_SYSROOT_DIR} install
    popd

    rm -v ${LINUX_SYSROOT_DIR}/usr/lib64/libibus*.la
<<<CLEAR_DIR>>>
