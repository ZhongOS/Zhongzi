<<<TAR_UNCOMPRESS>>>
        <<<PATCH>>>
        ./configure --prefix=${PREFIX}/${LINUX_HOST} --build=${CROSS_HOST} \
                --host=${CROSS_HOST} --target=${LINUX_HOST}
        <<<MAKE>>>
	make install
#         cp -f ${PREFIX}/${LINUX_HOST}/bin/pkgconf ${PREFIX}/${LINUX_HOST}/bin/${LINUX_HOST}-pkg-config
<<<CLEAR_DIR>>>

rm -f ${PREFIX}/${LINUX_HOST}/bin/${LINUX_HOST}-pkg-config

cat > ${PREFIX}/${LINUX_HOST}/bin/${LINUX_HOST}-pkg-config << EOF
#!/bin/bash -e

if echo "\$@" | grep -q "\--variable=" && \\
 ! echo "\$@" | grep -q "variable=datadir vapigen" && \\
 ! echo "\$@" | grep -q "variable=datadir gobject-introspection" && \\
 ! echo "\$@" | grep -q "variable=pkgdatadir wayland" && \\
 ! echo "\$@" | grep -q "variable=xcbincludedir xcb-proto" && \\
 ! echo "\$@" | grep -q "variable=pythondir xcb-proto" && \\
 ! echo "\$@" | grep -q "variable=libdir " && \\
 ! echo "\$@" | grep -q "variable=includedir "; then
# 
# if echo "\$@" | grep -q "\--variable=" && \\
#  ! echo "\$@" | grep -q "variable=libdir " && \\
#  ! echo "\$@" | grep -q "variable=includedir " && \\
#  ! echo "\$@" | grep -q "variable=datadir vapigen" && \\
#  ! echo "\$@" | grep -q "variable=bindir Qt6Core" && \\
#  ! echo "\$@" | grep -q "variable=libexecdir Qt6Core" && \\
#  ! echo "\$@" | grep -q "variable=interfaces_dir flatpak" && \\
#  ! echo "\$@" | grep -q "variable=pkgdatadir wayland" && \\
#  ! echo "\$@" | grep -q "variable=xcbincludedir xcb-proto" && \\
#  ! echo "\$@" | grep -q "variable=pythondir xcb-proto" && \\
#  ! echo "\$@" | grep -q "wayland-protocols"; then
    unset PKG_CONFIG_SYSROOT_DIR
fi

${PREFIX}/${LINUX_HOST}/bin/pkgconf "\$@"
EOF
chmod +x ${PREFIX}/${LINUX_HOST}/bin/${LINUX_HOST}-pkg-config
