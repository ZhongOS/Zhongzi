<<<TAR_UNCOMPRESS>>>
	<<<PATCH>>>
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG}  \
			..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		ninja
		run_step_package_check ninja
		DESTDIR=${PWD}/dest ninja install
		cp -a ${PWD}/dest/* ${SYSROOT_DIR}/
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}*.la
<<<CLEAR_DIR>>>

[[[1.30.8]]]
<<<TAR_UNCOMPRESS>>>
    sed -i "s@\$PKG_CONFIG_SYSROOT_DIR@@g" configure
    mkdir cross-build
    pushd cross-build
        ../configure ${COMMON_CONFIG} --enable-introspection
        <<<MAKE>>> INTROSPECTION_SCANNER=${CROSS_TARGET}-g-ir-scanner \
             INTROSPECTION_COMPILER=${CROSS_TARGET}-g-ir-compiler
        make DESTDIR=${SYSROOT_DIR} install
    popd
    rm -v ${SYSROOT_DIR}/usr/lib64/libqmi*.la
<<<CLEAR_DIR>>>
