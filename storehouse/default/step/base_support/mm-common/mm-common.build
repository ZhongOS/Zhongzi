<<<TAR_UNCOMPRESS>>>
	<<<PATCH>>>
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG} \
			..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		<<<NINJA_AND_INSTALL>>>
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}*.la
<<<CLEAR_DIR>>>

cp -av ${SYSROOT_DIR}/usr/bin/mm-common-get ${CROSSTOOLS_DIR}/bin/
sed -i "s@\"/usr/share\"@\"${SYSROOT_DIR}/usr/share\"@g" ${CROSSTOOLS_DIR}/bin/mm-common-get
