<<<TAR_UNCOMPRESS>>>
	<<<PATCH>>>
	mkdir -p subprojects/glibmm-2.4
	tar xvf ${RESOURCEDIR}/files/libxml++2-glibmm24_git.tar.gz -C subprojects/glibmm-2.4 --strip-components=1
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG} <<<EXTRA_PARM>>> \
			..
		<<<NINJA_AND_INSTALL>>>
	popd
	rm -f ${SYSROOT_DIR}/usr/lib64/*.la
<<<CLEAR_DIR>>>
